rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A missing role means 'user'. Admins are only set in the Firebase console.
    function roleOf(data) {
      return data.get('role', 'user');
    }

    function myRole() {
      return roleOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function validStoreVersion(v) {
      return v is string && v.matches('^([0-9]{1,3}([.][0-9]{1,3}){1,2})?$');
    }

    function isStaff() {
      return signedIn() && myRole() in ['support', 'admin'];
    }

    function optionalString(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function validPet(data) {
      return data.keys().hasOnly([
          'ownerId', 'name', 'species', 'breed', 'color', 'sex', 'age',
          'features', 'photoUrls', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.species in ['dog', 'cat', 'other']
        && data.photoUrls is list && data.photoUrls.size() > 0 && data.photoUrls.size() <= 4
        && (!('sex' in data) || data.sex in ['M', 'F', 'unknown'])
        && optionalString(data, 'breed', 60)
        && optionalString(data, 'color', 60)
        && optionalString(data, 'age', 30)
        && optionalString(data, 'features', 500);
    }

    function validVideo(data) {
      return data.keys().hasOnly([
          'title', 'category', 'tags', 'language', 'source', 'videoUrl', 'storagePath',
          'thumbnailUrl', 'thumbnailPath', 'durationSeconds', 'active', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.category in ['motivational', 'educational']
        && data.tags is list && data.tags.size() > 0 && data.tags.size() <= 4
        && data.tags.hasOnly(['dog', 'cat', 'other', 'general'])
        && data.language is string && data.language.size() <= 5
        && data.source == 'upload'
        && data.videoUrl is string
        && data.storagePath is string
        && data.active is bool
        && (!('durationSeconds' in data) || data.durationSeconds is int);
    }

    // Written only by Cloud Functions: points, daily rewards, invites, activity and the home geohash.
    function serverUserFields() {
      return ['points', 'daily', 'activity', 'installHashes', 'inviteCode', 'referredBy',
        'referralCount', 'ambassadorLevel', 'homeGeohash', 'inviteTries', 'feedbackDay'];
    }

    function validEmergency(data) {
      return data.keys().hasOnly([
          'ownerId', 'ownerName', 'type', 'species', 'description', 'photoUrls', 'lat', 'lng',
          'placeLabel', 'city', 'cityKey', 'contactPhone', 'status', 'createdAt', 'updatedAt',
          'lastActivityAt'
        ])
        && data.type in ['injured', 'danger', 'abandoned', 'urgent_found', 'intervention', 'other']
        && data.species in ['dog', 'cat', 'other']
        && data.description is string && data.description.size() <= 1000
        && data.photoUrls is list && data.photoUrls.size() <= 4
        && data.lat is number && data.lng is number
        && data.status == 'open'
        && data.ownerName is string && data.ownerName.size() <= 80
        && optionalString(data, 'placeLabel', 160)
        && optionalString(data, 'city', 80)
        && optionalString(data, 'cityKey', 120)
        && optionalString(data, 'contactPhone', 20);
    }

    function validContact(data) {
      return data.keys().hasOnly([
          'name', 'kind', 'phones', 'email', 'address', 'city', 'lat', 'lng', 'areaKm', 'types',
          'open24h', 'hours', 'verified', 'recommended', 'active', 'isTest', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.kind in ['vet', 'association', 'public_service', 'other']
        && data.phones is list && data.phones.size() <= 5
        && data.lat is number && data.lng is number
        && data.types is list
        && data.types.hasOnly(['injured', 'danger', 'abandoned', 'urgent_found', 'intervention', 'other'])
        && data.verified is bool && data.recommended is bool && data.active is bool && data.isTest is bool
        && (!('areaKm' in data) || data.areaKm == null || data.areaKm is number)
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 120))
        && (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 200))
        && (!('hours' in data) || data.hours == null || (data.hours is string && data.hours.size() <= 200));
    }

    function petitionTextOk(data, field, maxLength) {
      return data[field] is string && data[field].size() > 0 && data[field].size() <= maxLength;
    }

    // Approving or publishing needs every verification check ticked.
    function validPetition(data, petitionId) {
      return data.keys().hasOnly([
          'url', 'title', 'source', 'topic', 'country', 'startedOn', 'summary', 'issue',
          'action', 'why', 'imageUrl', 'imagePath', 'imagePermission', 'review', 'status',
          'checks', 'rejectReason', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
          'publishedAt'
        ])
        && data.url is string && data.url.size() <= 500
        && data.url.matches('^https://[^\\s/@]+[.][^\\s/@]+(/[^\\s]*)?$')
        && petitionTextOk(data, 'title', 140)
        && petitionTextOk(data, 'source', 80)
        && petitionTextOk(data, 'summary', 300)
        && petitionTextOk(data, 'issue', 1500)
        && petitionTextOk(data, 'action', 800)
        && petitionTextOk(data, 'why', 800)
        && data.topic in ['pets', 'wildlife', 'farm', 'testing', 'entertainment', 'marine', 'other']
        && optionalString(data, 'country', 80)
        && optionalString(data, 'rejectReason', 300)
        && (!('startedOn' in data) || data.startedOn is timestamp)
        && data.imagePermission is bool
        && (!('imageUrl' in data)
          || (data.imageUrl is string && data.imagePermission == true
            && data.imagePath is string
            && data.imagePath.matches('^petitions/' + petitionId + '/image_[0-9]+[.](jpg|jpeg|png|webp)$')))
        && (('imageUrl' in data) == ('imagePath' in data))
        && data.review in ['pending', 'approved', 'rejected', 'published']
        && data.status in ['active', 'completed', 'closed', 'unavailable']
        && data.checks is map
        && data.checks.keys().hasOnly(['exists', 'genuine', 'clearGoal', 'notMisleading'])
        && (!(data.review in ['approved', 'published'])
          || (data.checks.get('exists', false) == true
            && data.checks.get('genuine', false) == true
            && data.checks.get('clearGoal', false) == true
            && data.checks.get('notMisleading', false) == true))
        && (data.review != 'published' || data.get('publishedAt', null) is timestamp)
        && (!('publishedAt' in data) || data.publishedAt is timestamp)
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    // Users only reach the shop while an admin has it switched on.
    function shopOpen() {
      return get(/databases/$(database)/documents/config/shop).data.get('enabled', false) == true;
    }

    function shopReadable(data) {
      return isAdmin() || (signedIn() && data.active == true && shopOpen());
    }

    function shopName(data, maxLength) {
      return data.name is string && data.name.trim().size() > 0 && data.name.size() <= maxLength;
    }

    function shopLink(data, field) {
      return data[field] is string
        && (data[field] == '' || (data[field].size() <= 500
          && data[field].matches('^https://[^\\s/@]+[.][^\\s/@]+(/[^\\s]*)?$')));
    }

    function shopStamped(data) {
      return data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }

    function optionalCents(data, field) {
      return data[field] == null || (data[field] is int && data[field] > 0 && data[field] <= 1000000);
    }

    function validShopCategory(data) {
      return data.keys().hasOnly(['name', 'parentId', 'icon', 'order', 'active', 'updatedBy', 'updatedAt'])
        && shopName(data, 80)
        && data.parentId is string && data.parentId.size() <= 64
        && data.icon in ['food', 'accessories', 'care', 'toys', 'beds', 'carriers', 'tech', 'other']
        && data.order is int && data.order >= 0 && data.order <= 9999
        && data.active is bool
        && shopStamped(data);
    }

    function validBrand(data, brandId) {
      return data.keys().hasOnly(['name', 'description', 'website', 'logoUrl', 'logoPath', 'active', 'updatedBy', 'updatedAt'])
        && shopName(data, 80)
        && data.description is string && data.description.size() <= 1000
        && shopLink(data, 'website')
        && data.active is bool
        && (('logoUrl' in data) == ('logoPath' in data))
        && (!('logoPath' in data)
          || (data.logoUrl is string
            && data.logoPath.matches('^shop/brands/' + brandId + '/logo_[0-9]+[.](jpg|jpeg|png|webp)$')))
        && shopStamped(data);
    }

    function validSupplier(data) {
      return data.keys().hasOnly(['name', 'contactName', 'email', 'phone', 'website', 'orderMethod', 'notes', 'active', 'updatedBy', 'updatedAt'])
        && shopName(data, 80)
        && data.contactName is string && data.contactName.size() <= 80
        && data.email is string && data.email.size() <= 80
        && data.phone is string && data.phone.size() <= 30
        && shopLink(data, 'website')
        && data.orderMethod in ['manual', 'email']
        && (data.orderMethod != 'email' || data.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$'))
        && data.notes is string && data.notes.size() <= 1000
        && data.active is bool
        && shopStamped(data);
    }

    // Affiliate products may leave the price empty; every other product needs one.
    function validProduct(data) {
      return data.keys().hasOnly([
          'name', 'description', 'categoryId', 'brandId', 'supplierId', 'salesModel', 'animals',
          'priceCents', 'compareAtCents', 'availability', 'affiliateUrl', 'partnerName', 'active',
          'sponsored', 'sponsorStart', 'sponsorEnd', 'images', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && shopName(data, 120)
        && data.description is string && data.description.size() <= 4000
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 64
        && data.brandId is string && data.brandId.size() <= 64
        && data.supplierId is string && data.supplierId.size() <= 64
        && data.salesModel in ['ownStock', 'brandPartner', 'dropship', 'affiliate']
        && data.animals is list && data.animals.size() <= 3 && data.animals.hasOnly(['dog', 'cat', 'other'])
        && optionalCents(data, 'priceCents')
        && optionalCents(data, 'compareAtCents')
        && (data.salesModel == 'affiliate' || data.priceCents != null)
        && (data.compareAtCents == null || (data.priceCents != null && data.compareAtCents > data.priceCents))
        && data.availability in ['inStock', 'lowStock', 'outOfStock', 'comingSoon']
        && shopLink(data, 'affiliateUrl')
        && data.partnerName is string && data.partnerName.size() <= 80
        && (data.salesModel != 'affiliate'
          || (data.affiliateUrl != '' && data.partnerName.trim().size() > 0 && data.supplierId == ''))
        && data.active is bool
        && data.get('sponsored', false) is bool
        && (data.get('sponsorStart', null) == null || data.sponsorStart is timestamp)
        && (data.get('sponsorEnd', null) == null || data.sponsorEnd is timestamp)
        && data.images is list && data.images.size() <= 6
        && shopStamped(data);
    }

    function validShipping(data) {
      return data.keys().hasOnly(['zones', 'methods', 'updatedBy', 'updatedAt'])
        && data.zones is list && data.zones.size() <= 20
        && data.methods is list && data.methods.size() <= 10
        && shopStamped(data);
    }

    function supportCase(caseId) {
      return get(/databases/$(database)/documents/supportCases/$(caseId)).data;
    }

    function validReport(data) {
      return data.keys().hasOnly([
          'ownerId', 'ownerName', 'ownerContact', 'type', 'petId', 'petName',
          'species', 'description', 'photoUrls', 'country', 'city', 'cityKey',
          'placeDetail', 'areaRadius', 'lat', 'lng', 'eventAt', 'status', 'contactPhone',
          'contactEmail', 'whatsapp', 'reward', 'createdAt', 'updatedAt', 'resolvedAt'
        ])
        && data.type in ['lost', 'found']
        && data.status in ['open', 'resolved', 'closed']
        && data.species in ['dog', 'cat', 'other']
        && data.petName is string && data.petName.size() > 0 && data.petName.size() <= 60
        && data.ownerName is string && data.ownerName.size() <= 80
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 1000
        && data.photoUrls is list && data.photoUrls.size() > 0 && data.photoUrls.size() <= 4
        && data.city is string && data.city.size() > 0
        && data.cityKey is string && data.cityKey.size() > 0
        && data.lat is number && data.lng is number
        && data.eventAt is string
        && (data.get('contactPhone', null) != null || data.get('contactEmail', null) != null)
        && optionalString(data, 'contactPhone', 20)
        && optionalString(data, 'contactEmail', 100)
        && optionalString(data, 'placeDetail', 80)
        && (!('areaRadius' in data) || (data.areaRadius is int && data.areaRadius >= 50 && data.areaRadius <= 500))
        && (!('reward' in data) || (data.type == 'lost' && data.reward is int && data.reward >= 1 && data.reward <= 99999));
    }

    match /users/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid) && roleOf(request.resource.data) == 'user'
        && !request.resource.data.keys().hasAny(serverUserFields());
      allow update: if (isUser(uid)
          && roleOf(request.resource.data) == roleOf(resource.data)
          && request.resource.data.get('disabled', false) == resource.data.get('disabled', false)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverUserFields())
          && (!('blockedUsers' in request.resource.data)
            || (request.resource.data.blockedUsers is map
              && request.resource.data.blockedUsers.size() <= 500))
          && (!('notificationPrefs' in request.resource.data)
            || (request.resource.data.notificationPrefs is map
              && request.resource.data.notificationPrefs.keys().hasOnly(['lost', 'found', 'resolved', 'support', 'emergency']))))
        || (isAdmin() && !isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
          && roleOf(resource.data) in ['user', 'support']
          && roleOf(request.resource.data) in ['user', 'support']);
      allow delete: if isUser(uid);

      match /pointsLedger/{entryId} {
        allow read: if isUser(uid) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read, delete: if isUser(uid);
        allow update: if isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
      }
    }

    match /pets/{petId} {
      allow read: if isUser(resource.data.ownerId);
      allow create: if isUser(request.resource.data.ownerId)
        && validPet(request.resource.data);
      allow update: if isUser(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && validPet(request.resource.data);
      allow delete: if isUser(resource.data.ownerId);
    }

    function ownsPet(petId) {
      return petId is string && petId.size() > 0 && petId.size() <= 128
        && exists(/databases/$(database)/documents/pets/$(petId))
        && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
    }

    function isDay(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function validHeatCycle(data) {
      return data.keys().hasOnly(['ownerId', 'petId', 'start', 'end', 'notes', 'createdAt', 'updatedAt'])
        && isDay(data.start)
        && (data.end == null || (isDay(data.end) && data.end >= data.start))
        && data.notes is string && data.notes.size() <= 500
        && data.updatedAt == request.time;
    }

    // Heat cycles: private to the pet's owner.
    match /heatCycles/{cycleId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isUser(request.resource.data.ownerId)
        && ownsPet(request.resource.data.petId)
        && validHeatCycle(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isUser(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.petId == resource.data.petId
        && request.resource.data.createdAt == resource.data.createdAt
        && validHeatCycle(request.resource.data);
      allow delete: if isUser(resource.data.ownerId);
    }

    // One per pet while reminders are on; the daily sweep sends them.
    match /heatReminders/{petId} {
      allow read: if signedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow delete: if signedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create, update: if isUser(request.resource.data.ownerId)
        && (resource == null || resource.data.ownerId == request.auth.uid)
        && ownsPet(petId)
        && request.resource.data.keys().hasOnly([
          'ownerId', 'petId', 'petName', 'nextStart', 'cycleDays', 'daysBefore', 'remindOn', 'updatedAt'
        ])
        && request.resource.data.petId == petId
        && request.resource.data.petName is string && request.resource.data.petName.size() <= 60
        && isDay(request.resource.data.nextStart)
        && isDay(request.resource.data.remindOn)
        && request.resource.data.cycleDays is int
        && request.resource.data.cycleDays >= 7 && request.resource.data.cycleDays <= 400
        && request.resource.data.daysBefore in [1, 3, 7, 14]
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- Pet sitting ----------

    function sittingSpecies(list) {
      return list is list && list.size() >= 1 && list.size() <= 3 && list.toSet().hasOnly(['dog', 'cat', 'other']);
    }

    function sittingServices(list) {
      return list is list && list.size() >= 1 && list.size() <= 5
        && list.toSet().hasOnly(['visits', 'overnight', 'walks', 'daycare', 'boarding']);
    }

    function textUpTo(value, max) {
      return value is string && value.size() <= max;
    }

    function cityPlace(data) {
      return textUpTo(data.city, 80) && data.city.size() > 0
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180;
    }

    function notBlockedBy(uid) {
      return !(request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('blockedUsers', {}));
    }

    function sitterFields() {
      return ['uid', 'name', 'photoUrl', 'about', 'experience', 'species', 'services', 'availability',
              'city', 'lat', 'lng', 'areaKm', 'active', 'hidden', 'createdAt', 'updatedAt'];
    }

    function validSitter(data, uid) {
      return data.uid == uid
        && textUpTo(data.name, 80)
        && (!('photoUrl' in data) || data.photoUrl == null || textUpTo(data.photoUrl, 1000))
        && textUpTo(data.about, 800) && data.about.size() >= 10
        && textUpTo(data.experience, 500)
        && sittingSpecies(data.species)
        && sittingServices(data.services)
        && textUpTo(data.availability, 300)
        && cityPlace(data)
        && data.areaKm in [2, 5, 10, 25, 50]
        && data.active is bool
        && data.updatedAt == request.time;
    }

    // Public sitter profiles; rating and counts are written only by Cloud Functions.
    match /sitters/{uid} {
      allow read: if isUser(uid) || isStaff() || (signedIn() && resource.data.hidden == false);
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(sitterFields())
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time
        && validSitter(request.resource.data, uid);
      allow update: if (isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'photoUrl', 'about', 'experience', 'species', 'services', 'availability',
                         'city', 'lat', 'lng', 'areaKm', 'active', 'updatedAt'])
          && validSitter(request.resource.data, uid))
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
          && request.resource.data.hidden is bool);
      allow delete: if isUser(uid);
    }

    function validSittingRequest(data) {
      return data.keys().hasOnly(['ownerId', 'ownerName', 'petIds', 'petNames', 'species', 'service', 'start', 'end',
                                  'city', 'lat', 'lng', 'notes', 'budget', 'status', 'hidden', 'createdAt', 'updatedAt'])
        && textUpTo(data.ownerName, 80)
        && data.petIds is list && data.petIds.size() >= 1 && data.petIds.size() <= 10
        && data.petNames is list && data.petNames.size() == data.petIds.size()
        && sittingSpecies(data.species)
        && data['service'] in ['visits', 'overnight', 'walks', 'daycare', 'boarding']
        && isDay(data.start) && isDay(data.end) && data.end >= data.start
        && cityPlace(data)
        && textUpTo(data.notes, 800)
        && (!('budget' in data) || textUpTo(data.budget, 40))
        && data.updatedAt == request.time;
    }

    // Requests show the city only, never an address.
    match /sittingRequests/{requestId} {
      allow read: if signedIn() && (resource.data.hidden == false || resource.data.ownerId == request.auth.uid || isStaff());
      allow create: if isUser(request.resource.data.ownerId)
        && validSittingRequest(request.resource.data)
        && request.resource.data.status == 'open'
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time;
      allow update: if (isUser(resource.data.ownerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'budget', 'updatedAt'])
          && textUpTo(request.resource.data.notes, 800)
          && (!('budget' in request.resource.data) || textUpTo(request.resource.data.budget, 40))
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status == resource.data.status
            || (resource.data.status in ['open', 'booked'] && request.resource.data.status == 'closed')))
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
          && request.resource.data.hidden is bool);
    }

    // The ID is `{requestId}_{sitterId}`: one offer per sitter per request.
    match /sittingOffers/{offerId} {
      allow read: if signedIn()
        && (resource.data.sitterId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isUser(request.resource.data.sitterId)
        && offerId == request.resource.data.requestId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['requestId', 'ownerId', 'sitterId', 'sitterName', 'message', 'price', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && textUpTo(request.resource.data.sitterName, 80)
        && textUpTo(request.resource.data.message, 500) && request.resource.data.message.size() > 0
        && (!('price' in request.resource.data) || textUpTo(request.resource.data.price, 40))
        && request.resource.data.createdAt == request.time
        && request.resource.data.ownerId != request.auth.uid
        && exists(/databases/$(database)/documents/sitters/$(request.auth.uid))
        && get(/databases/$(database)/documents/sittingRequests/$(request.resource.data.requestId)).data.status == 'open'
        && get(/databases/$(database)/documents/sittingRequests/$(request.resource.data.requestId)).data.ownerId == request.resource.data.ownerId
        && notBlockedBy(request.resource.data.ownerId);
      allow update: if (isUser(resource.data.sitterId) && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'message', 'price'])
          && request.resource.data.status in ['pending', 'withdrawn']
          && textUpTo(request.resource.data.message, 500)
          && (!('price' in request.resource.data) || textUpTo(request.resource.data.price, 40)))
        || (isUser(resource.data.ownerId) && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'declined');
    }

    // Chats between two users; the ID is both user IDs, sorted, joined by "_".
    match /sittingChats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'names', 'lastMessage', 'lastAt', 'lastSender', 'readAt', 'createdAt'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.names is map
        && request.resource.data.createdAt == request.time
        && notBlockedBy(request.resource.data.members[0])
        && notBlockedBy(request.resource.data.members[1]);
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt', 'lastSender', 'readAt', 'names'])
        && textUpTo(request.resource.data.lastMessage, 140);

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/sittingChats/$(chatId)).data.members;
        allow create: if isUser(request.resource.data.senderId)
          && request.resource.data.keys().hasOnly(['senderId', 'to', 'text', 'at'])
          && request.auth.uid in get(/databases/$(database)/documents/sittingChats/$(chatId)).data.members
          && request.resource.data.to in get(/databases/$(database)/documents/sittingChats/$(chatId)).data.members
          && request.resource.data.to != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.at == request.time
          && notBlockedBy(request.resource.data.to);
      }
    }

    // Verified reviews: written only by Cloud Functions after both sides confirmed the service.
    match /sittingReviews/{reviewId} {
      allow read: if signedIn() && (resource == null || resource.data.hidden == false || isStaff() || resource.data.reviewerId == request.auth.uid);
    }

    // One report per user per item: the ID is `{reporterId}_{kind}_{targetId}`.
    match /sittingFlags/{flagId} {
      allow read: if isStaff() || (signedIn() && (resource == null || resource.data.reporterId == request.auth.uid));
      allow create: if isUser(request.resource.data.reporterId)
        && request.resource.data.keys().hasOnly(['reporterId', 'kind', 'targetId', 'targetOwnerId', 'reason', 'note', 'createdAt'])
        && request.resource.data.kind in ['request', 'sitter', 'review', 'chat']
        && flagId == request.auth.uid + '_' + request.resource.data.kind + '_' + request.resource.data.targetId
        && textUpTo(request.resource.data.targetId, 256)
        && request.resource.data.targetOwnerId is string
        && request.resource.data.targetOwnerId != request.auth.uid
        && request.resource.data.reason in ['spam', 'scam', 'inappropriate', 'wrongInfo', 'other']
        && optionalString(request.resource.data, 'note', 300)
        && request.resource.data.createdAt == request.time;
      allow delete: if isStaff();
    }

    match /config/sitting {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'minAccountDays', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.minAccountDays is int
        && request.resource.data.minAccountDays >= 0 && request.resource.data.minAccountDays <= 60
        && shopStamped(request.resource.data);
    }

    match /reports/{reportId} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.ownerId)
        && request.resource.data.status == 'open'
        && validReport(request.resource.data);
      // Hidden reports can only be changed by staff.
      allow update: if (isUser(resource.data.ownerId)
          && resource.data.status != 'hidden'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt', 'updatedAt'])
          && request.resource.data.status in ['open', 'resolved', 'closed'])
        || (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'hiddenBy', 'updatedAt'])
          && request.resource.data.status in ['open', 'resolved', 'hidden']
          && !('hiddenBy' in request.resource.data));
      allow delete: if isUser(resource.data.ownerId) || isAdmin();
    }

    // Users only see active videos, so their queries must filter on `active`.
    match /videos/{videoId} {
      allow read: if (signedIn() && resource.data.active == true) || isAdmin();
      allow create, update: if isAdmin() && validVideo(request.resource.data);
      allow delete: if isAdmin();
    }

    // One flag per user per report: the ID is `{reporterId}_{reportId}`.
    match /flags/{flagId} {
      allow read: if isStaff() || isUser(resource.data.reporterId);
      allow create: if isUser(request.resource.data.reporterId)
        && flagId == request.auth.uid + '_' + request.resource.data.reportId
        && request.resource.data.keys().hasOnly([
            'reportId', 'reportOwnerId', 'reporterId', 'reason', 'note', 'createdAt'
          ])
        && request.resource.data.reportId is string
        && request.resource.data.reportOwnerId is string
        && request.resource.data.reportOwnerId != request.auth.uid
        && request.resource.data.reason in ['spam', 'scam', 'inappropriate', 'wrongInfo', 'other']
        && optionalString(request.resource.data, 'note', 300)
        && request.resource.data.createdAt == request.time;
      allow delete: if isStaff();
    }

    // Support cases, events and stats are written only by Cloud Functions.
    match /supportCases/{caseId} {
      allow read: if isStaff() || isUser(resource.data.userId);

      // Users write as the case owner; support staff only once they took the case.
      match /messages/{messageId} {
        allow read: if isStaff() || isUser(supportCase(caseId).userId);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && supportCase(caseId).status != 'closed'
          && ((request.resource.data.senderRole == 'user'
              && supportCase(caseId).userId == request.auth.uid)
            || (request.resource.data.senderRole == 'staff'
              && (isAdmin() || (isStaff() && supportCase(caseId).assignedTo == request.auth.uid))));
      }

      match /events/{eventId} {
        allow read: if isStaff();
      }
    }

    match /staffPresence/{uid} {
      allow read: if isStaff();
      allow create, update: if isUser(uid) && isStaff()
        && request.resource.data.keys().hasOnly(['state', 'lastSeen'])
        && request.resource.data.state in ['online', 'away', 'offline']
        && request.resource.data.lastSeen == request.time;
      allow delete: if isUser(uid);
    }

    match /staffStats/{uid} {
      allow read: if isAdmin() || (isUser(uid) && isStaff());
    }

    // Created by the reporter; every later change goes through `updateEmergency`.
    match /emergencies/{emergencyId} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.ownerId)
        && validEmergency(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivityAt == request.time;
      allow delete: if isUser(resource.data.ownerId) || isAdmin();

      match /events/{eventId} {
        allow read: if isStaff();
      }
    }

    // Users only see active contacts, so their queries must filter on `active`.
    match /emergencyContacts/{contactId} {
      allow read: if (signedIn() && resource.data.active == true) || isStaff();
      allow create, update: if isAdmin() && validContact(request.resource.data);
      allow delete: if isAdmin();
    }

    // Keyed by the invited user. Written only by Cloud Functions.
    match /referrals/{inviteeId} {
      allow read: if isUser(inviteeId)
        || (signedIn() && resource.data.inviterId == request.auth.uid)
        || isAdmin();
    }

    match /config/points {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'dailyCheckin', 'dailyActive', 'activeMinutes', 'streakDays', 'streakBonus',
          'referralQualified', 'referralWelcome', 'qualifyDays', 'qualifyWithinDays',
          'codeEntryDays', 'maxQualifiedPerDay', 'feedbackPoints', 'feedbackAfterDays',
          'reviewAfterDays', 'reviewMinActiveDays', 'reviewEveryDays', 'stillUsingDays', 'levels'
        ]);
    }

    // Written only by the `submitFeedback` function.
    match /feedback/{feedbackId} {
      allow read: if isStaff();
    }

    // "What's new" notes for each app version, written in the admin side.
    match /releaseNotes/{version} {
      allow read: if (signedIn() && resource.data.published == true) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['version', 'code', 'published', 'notes', 'updatedAt'])
        && request.resource.data.version == version
        && request.resource.data.code is int
        && version.matches('^[0-9]{1,3}([.][0-9]{1,3}){1,2}$')
        && request.resource.data.published is bool
        && request.resource.data.notes is map;
      allow delete: if isAdmin();
    }

    // Petitions picked by the team. Users only see published ones, so their
    // queries must filter on `review`.
    match /petitions/{petitionId} {
      allow read: if (signedIn() && resource.data.review == 'published') || isAdmin();
      allow create: if isAdmin()
        && validPetition(request.resource.data, petitionId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && validPetition(request.resource.data, petitionId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /config/shop {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'disabledSuppliers', 'disabledModels', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.disabledSuppliers is list
        && request.resource.data.disabledSuppliers.size() <= 500
        && request.resource.data.disabledModels is list
        && request.resource.data.disabledModels.hasOnly(['ownStock', 'brandPartner', 'dropship', 'affiliate'])
        && shopStamped(request.resource.data);
    }

    // Donation settings. paymentsReady is only set from the console once store products exist.
    match /config/donations {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'enabled', 'showInProfile', 'afterReport', 'afterFound', 'daysBetweenPrompts',
          'amountsCents', 'paymentsReady', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.showInProfile is bool
        && request.resource.data.afterReport is bool
        && request.resource.data.afterFound is bool
        && request.resource.data.daysBetweenPrompts is int
        && request.resource.data.daysBetweenPrompts >= 1 && request.resource.data.daysBetweenPrompts <= 365
        && request.resource.data.amountsCents is list
        && request.resource.data.amountsCents.size() >= 1 && request.resource.data.amountsCents.size() <= 6
        && request.resource.data.paymentsReady == (resource == null ? false : resource.data.get('paymentsReady', false))
        && shopStamped(request.resource.data);
    }

    // Places to walk settings. Searches go through Cloud Functions only.
    match /config/walks {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'enabled', 'defaultRadiusKm', 'groups', 'hiddenPlaceIds', 'hiddenNames',
          'dailySearches', 'dailyDetails', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.defaultRadiusKm in [1, 3, 5, 10, 25]
        && request.resource.data.groups is map
        && request.resource.data.groups.keys().hasOnly(['dogParks', 'parks', 'green', 'trails'])
        && request.resource.data.hiddenPlaceIds is list
        && request.resource.data.hiddenPlaceIds.size() <= 500
        && request.resource.data.hiddenNames is map
        && request.resource.data.dailySearches is int
        && request.resource.data.dailySearches >= 1 && request.resource.data.dailySearches <= 1000
        && request.resource.data.dailyDetails is int
        && request.resource.data.dailyDetails >= 1 && request.resource.data.dailyDetails <= 1000
        && shopStamped(request.resource.data);
    }

    // Breed scanner settings. Scans go through Cloud Functions only.
    match /config/scanner {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'dailyScans', 'model', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.dailyScans is int
        && request.resource.data.dailyScans >= 1 && request.resource.data.dailyScans <= 100
        && request.resource.data.model is string
        && request.resource.data.model.matches('gemini-[a-z0-9.-]{1,60}')
        && shopStamped(request.resource.data);
    }

    // Heat calendar settings: typical cycle and heat length per species (0 = no default).
    match /config/heat {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'cycleDays', 'heatDays', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.cycleDays is map
        && request.resource.data.cycleDays.keys().hasOnly(['dog', 'cat', 'other'])
        && request.resource.data.heatDays is map
        && request.resource.data.heatDays.keys().hasOnly(['dog', 'cat', 'other'])
        && shopStamped(request.resource.data);
    }

    match /config/shipping {
      allow read: if signedIn();
      allow write: if isAdmin() && validShipping(request.resource.data);
    }

    // Cost prices: admins only, never readable by users.
    match /productCosts/{productId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['costCents', 'updatedBy', 'updatedAt'])
        && request.resource.data.costCents is int
        && request.resource.data.costCents >= 0
        && request.resource.data.costCents <= 1000000
        && shopStamped(request.resource.data);
    }

    // One line per tap on "Buy on …"; only admins read them.
    match /affiliateClicks/{clickId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['productId', 'partner', 'uid', 'at'])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 64
        && request.resource.data.partner is string
        && request.resource.data.partner.size() <= 80
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
    }

    match /shopCategories/{categoryId} {
      allow read: if shopReadable(resource.data);
      allow create, update: if isAdmin() && validShopCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if shopReadable(resource.data);
      allow create, update: if isAdmin() && validBrand(request.resource.data, brandId);
      allow delete: if isAdmin();
    }

    // Contact details and notes: admins only.
    match /suppliers/{supplierId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validSupplier(request.resource.data);
    }

    match /products/{productId} {
      allow read: if shopReadable(resource.data);
      allow create: if isAdmin()
        && validProduct(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && validProduct(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /config/emergency {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'ringsKm', 'minRecipients', 'maxRecipients', 'autoCloseHours', 'defaultAreaKm',
          'maxSuggested', 'weightRecommended', 'weightVerified', 'weight24h', 'weightPerKm',
          'emailEnabled'
        ]);
    }

    // Written only by Cloud Functions. Owners see the checks of their own photos.
    match /photoChecks/{checkId} {
      allow read: if isStaff() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /config/moderation {
      allow read: if isStaff();
    }

    // Store versions, read before sign-in too. Empty strings turn a check off.
    match /config/appVersion {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'androidLatest', 'androidMinimum', 'iosLatest', 'iosMinimum', 'appStoreId', 'updatedAt'
        ])
        && validStoreVersion(request.resource.data.get('androidLatest', ''))
        && validStoreVersion(request.resource.data.get('androidMinimum', ''))
        && validStoreVersion(request.resource.data.get('iosLatest', ''))
        && validStoreVersion(request.resource.data.get('iosMinimum', ''))
        && request.resource.data.get('appStoreId', '') is string
        && request.resource.data.get('appStoreId', '').matches('^([0-9]{6,12})?$');
    }

    match /config/support {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['chatReplyMinutes', 'ticketReplyHours', 'autoCloseDays'])
        && request.resource.data.get('chatReplyMinutes', 1) is int
        && request.resource.data.get('ticketReplyHours', 1) is int
        && request.resource.data.get('autoCloseDays', 1) is int;
    }
  }
}
