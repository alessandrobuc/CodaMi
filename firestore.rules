rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A missing role means 'user'. Admins are only set in the Firebase console.
    function roleOf(data) {
      return data.get('role', 'user');
    }

    function myRole() {
      return roleOf(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isStaff() {
      return signedIn() && myRole() in ['support', 'admin'];
    }

    function optionalString(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function validPet(data) {
      return data.keys().hasOnly([
          'ownerId', 'name', 'species', 'breed', 'color', 'sex', 'age',
          'features', 'photoUrls', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.species in ['dog', 'cat', 'other']
        && data.photoUrls is list && data.photoUrls.size() > 0 && data.photoUrls.size() <= 4
        && (!('sex' in data) || data.sex in ['M', 'F', 'unknown'])
        && optionalString(data, 'breed', 60)
        && optionalString(data, 'color', 60)
        && optionalString(data, 'age', 30)
        && optionalString(data, 'features', 500);
    }

    function validVideo(data) {
      return data.keys().hasOnly([
          'title', 'category', 'tags', 'language', 'source', 'videoUrl', 'storagePath',
          'thumbnailUrl', 'thumbnailPath', 'durationSeconds', 'active', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.category in ['motivational', 'educational']
        && data.tags is list && data.tags.size() > 0 && data.tags.size() <= 4
        && data.tags.hasOnly(['dog', 'cat', 'other', 'general'])
        && data.language is string && data.language.size() <= 5
        && data.source == 'upload'
        && data.videoUrl is string
        && data.storagePath is string
        && data.active is bool
        && (!('durationSeconds' in data) || data.durationSeconds is int);
    }

    // Written only by Cloud Functions: points, daily rewards, invites, activity and the home geohash.
    function serverUserFields() {
      return ['points', 'daily', 'activity', 'installHashes', 'inviteCode', 'referredBy',
        'referralCount', 'ambassadorLevel', 'homeGeohash', 'inviteTries', 'feedbackDay'];
    }

    function validEmergency(data) {
      return data.keys().hasOnly([
          'ownerId', 'ownerName', 'type', 'species', 'description', 'photoUrls', 'lat', 'lng',
          'placeLabel', 'city', 'cityKey', 'contactPhone', 'status', 'createdAt', 'updatedAt',
          'lastActivityAt'
        ])
        && data.type in ['injured', 'danger', 'abandoned', 'urgent_found', 'intervention', 'other']
        && data.species in ['dog', 'cat', 'other']
        && data.description is string && data.description.size() <= 1000
        && data.photoUrls is list && data.photoUrls.size() <= 4
        && data.lat is number && data.lng is number
        && data.status == 'open'
        && data.ownerName is string && data.ownerName.size() <= 80
        && optionalString(data, 'placeLabel', 160)
        && optionalString(data, 'city', 80)
        && optionalString(data, 'cityKey', 120)
        && optionalString(data, 'contactPhone', 20);
    }

    function validContact(data) {
      return data.keys().hasOnly([
          'name', 'kind', 'phones', 'email', 'address', 'city', 'lat', 'lng', 'areaKm', 'types',
          'open24h', 'hours', 'verified', 'recommended', 'active', 'isTest', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.kind in ['vet', 'association', 'public_service', 'other']
        && data.phones is list && data.phones.size() <= 5
        && data.lat is number && data.lng is number
        && data.types is list
        && data.types.hasOnly(['injured', 'danger', 'abandoned', 'urgent_found', 'intervention', 'other'])
        && data.verified is bool && data.recommended is bool && data.active is bool && data.isTest is bool
        && (!('areaKm' in data) || data.areaKm == null || data.areaKm is number)
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 120))
        && (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 200))
        && (!('hours' in data) || data.hours == null || (data.hours is string && data.hours.size() <= 200));
    }

    function petitionTextOk(data, field, maxLength) {
      return data[field] is string && data[field].size() > 0 && data[field].size() <= maxLength;
    }

    // Approving or publishing needs every verification check ticked.
    function validPetition(data, petitionId) {
      return data.keys().hasOnly([
          'url', 'title', 'source', 'topic', 'country', 'startedOn', 'summary', 'issue',
          'action', 'why', 'imageUrl', 'imagePath', 'imagePermission', 'review', 'status',
          'checks', 'rejectReason', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
          'publishedAt'
        ])
        && data.url is string && data.url.size() <= 500
        && data.url.matches('^https://[^\\s/@]+[.][^\\s/@]+(/[^\\s]*)?$')
        && petitionTextOk(data, 'title', 140)
        && petitionTextOk(data, 'source', 80)
        && petitionTextOk(data, 'summary', 300)
        && petitionTextOk(data, 'issue', 1500)
        && petitionTextOk(data, 'action', 800)
        && petitionTextOk(data, 'why', 800)
        && data.topic in ['pets', 'wildlife', 'farm', 'testing', 'entertainment', 'marine', 'other']
        && optionalString(data, 'country', 80)
        && optionalString(data, 'rejectReason', 300)
        && (!('startedOn' in data) || data.startedOn is timestamp)
        && data.imagePermission is bool
        && (!('imageUrl' in data)
          || (data.imageUrl is string && data.imagePermission == true
            && data.imagePath is string
            && data.imagePath.matches('^petitions/' + petitionId + '/image_[0-9]+[.](jpg|jpeg|png|webp)$')))
        && (('imageUrl' in data) == ('imagePath' in data))
        && data.review in ['pending', 'approved', 'rejected', 'published']
        && data.status in ['active', 'completed', 'closed', 'unavailable']
        && data.checks is map
        && data.checks.keys().hasOnly(['exists', 'genuine', 'clearGoal', 'notMisleading'])
        && (!(data.review in ['approved', 'published'])
          || (data.checks.get('exists', false) == true
            && data.checks.get('genuine', false) == true
            && data.checks.get('clearGoal', false) == true
            && data.checks.get('notMisleading', false) == true))
        && (data.review != 'published' || data.get('publishedAt', null) is timestamp)
        && (!('publishedAt' in data) || data.publishedAt is timestamp)
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function supportCase(caseId) {
      return get(/databases/$(database)/documents/supportCases/$(caseId)).data;
    }

    function validReport(data) {
      return data.keys().hasOnly([
          'ownerId', 'ownerName', 'ownerContact', 'type', 'petId', 'petName',
          'species', 'description', 'photoUrls', 'country', 'city', 'cityKey',
          'placeDetail', 'areaRadius', 'lat', 'lng', 'eventAt', 'status', 'contactPhone',
          'contactEmail', 'whatsapp', 'reward', 'createdAt', 'updatedAt', 'resolvedAt'
        ])
        && data.type in ['lost', 'found']
        && data.status in ['open', 'resolved', 'closed']
        && data.species in ['dog', 'cat', 'other']
        && data.petName is string && data.petName.size() > 0 && data.petName.size() <= 60
        && data.ownerName is string && data.ownerName.size() <= 80
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 1000
        && data.photoUrls is list && data.photoUrls.size() > 0 && data.photoUrls.size() <= 4
        && data.city is string && data.city.size() > 0
        && data.cityKey is string && data.cityKey.size() > 0
        && data.lat is number && data.lng is number
        && data.eventAt is string
        && (data.get('contactPhone', null) != null || data.get('contactEmail', null) != null)
        && optionalString(data, 'contactPhone', 20)
        && optionalString(data, 'contactEmail', 100)
        && optionalString(data, 'placeDetail', 80)
        && (!('areaRadius' in data) || (data.areaRadius is int && data.areaRadius >= 50 && data.areaRadius <= 500))
        && (!('reward' in data) || (data.type == 'lost' && data.reward is int && data.reward >= 1 && data.reward <= 99999));
    }

    match /users/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid) && roleOf(request.resource.data) == 'user'
        && !request.resource.data.keys().hasAny(serverUserFields());
      allow update: if (isUser(uid)
          && roleOf(request.resource.data) == roleOf(resource.data)
          && request.resource.data.get('disabled', false) == resource.data.get('disabled', false)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverUserFields())
          && (!('blockedUsers' in request.resource.data)
            || (request.resource.data.blockedUsers is map
              && request.resource.data.blockedUsers.size() <= 500))
          && (!('notificationPrefs' in request.resource.data)
            || (request.resource.data.notificationPrefs is map
              && request.resource.data.notificationPrefs.keys().hasOnly(['lost', 'found', 'resolved', 'support', 'emergency']))))
        || (isAdmin() && !isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
          && roleOf(resource.data) in ['user', 'support']
          && roleOf(request.resource.data) in ['user', 'support']);
      allow delete: if isUser(uid);

      match /pointsLedger/{entryId} {
        allow read: if isUser(uid) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read, delete: if isUser(uid);
        allow update: if isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
      }
    }

    match /pets/{petId} {
      allow read: if isUser(resource.data.ownerId);
      allow create: if isUser(request.resource.data.ownerId)
        && validPet(request.resource.data);
      allow update: if isUser(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && validPet(request.resource.data);
      allow delete: if isUser(resource.data.ownerId);
    }

    match /reports/{reportId} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.ownerId)
        && request.resource.data.status == 'open'
        && validReport(request.resource.data);
      // Hidden reports can only be changed by staff.
      allow update: if (isUser(resource.data.ownerId)
          && resource.data.status != 'hidden'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolvedAt', 'updatedAt'])
          && request.resource.data.status in ['open', 'resolved', 'closed'])
        || (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'hiddenBy', 'updatedAt'])
          && request.resource.data.status in ['open', 'resolved', 'hidden']
          && !('hiddenBy' in request.resource.data));
      allow delete: if isUser(resource.data.ownerId) || isAdmin();
    }

    // Users only see active videos, so their queries must filter on `active`.
    match /videos/{videoId} {
      allow read: if (signedIn() && resource.data.active == true) || isAdmin();
      allow create, update: if isAdmin() && validVideo(request.resource.data);
      allow delete: if isAdmin();
    }

    // One flag per user per report: the ID is `{reporterId}_{reportId}`.
    match /flags/{flagId} {
      allow read: if isStaff() || isUser(resource.data.reporterId);
      allow create: if isUser(request.resource.data.reporterId)
        && flagId == request.auth.uid + '_' + request.resource.data.reportId
        && request.resource.data.keys().hasOnly([
            'reportId', 'reportOwnerId', 'reporterId', 'reason', 'note', 'createdAt'
          ])
        && request.resource.data.reportId is string
        && request.resource.data.reportOwnerId is string
        && request.resource.data.reportOwnerId != request.auth.uid
        && request.resource.data.reason in ['spam', 'scam', 'inappropriate', 'wrongInfo', 'other']
        && optionalString(request.resource.data, 'note', 300)
        && request.resource.data.createdAt == request.time;
      allow delete: if isStaff();
    }

    // Support cases, events and stats are written only by Cloud Functions.
    match /supportCases/{caseId} {
      allow read: if isStaff() || isUser(resource.data.userId);

      // Users write as the case owner; support staff only once they took the case.
      match /messages/{messageId} {
        allow read: if isStaff() || isUser(supportCase(caseId).userId);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && supportCase(caseId).status != 'closed'
          && ((request.resource.data.senderRole == 'user'
              && supportCase(caseId).userId == request.auth.uid)
            || (request.resource.data.senderRole == 'staff'
              && (isAdmin() || (isStaff() && supportCase(caseId).assignedTo == request.auth.uid))));
      }

      match /events/{eventId} {
        allow read: if isStaff();
      }
    }

    match /staffPresence/{uid} {
      allow read: if isStaff();
      allow create, update: if isUser(uid) && isStaff()
        && request.resource.data.keys().hasOnly(['state', 'lastSeen'])
        && request.resource.data.state in ['online', 'away', 'offline']
        && request.resource.data.lastSeen == request.time;
      allow delete: if isUser(uid);
    }

    match /staffStats/{uid} {
      allow read: if isAdmin() || (isUser(uid) && isStaff());
    }

    // Created by the reporter; every later change goes through `updateEmergency`.
    match /emergencies/{emergencyId} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.ownerId)
        && validEmergency(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivityAt == request.time;
      allow delete: if isUser(resource.data.ownerId) || isAdmin();

      match /events/{eventId} {
        allow read: if isStaff();
      }
    }

    // Users only see active contacts, so their queries must filter on `active`.
    match /emergencyContacts/{contactId} {
      allow read: if (signedIn() && resource.data.active == true) || isStaff();
      allow create, update: if isAdmin() && validContact(request.resource.data);
      allow delete: if isAdmin();
    }

    // Keyed by the invited user. Written only by Cloud Functions.
    match /referrals/{inviteeId} {
      allow read: if isUser(inviteeId)
        || (signedIn() && resource.data.inviterId == request.auth.uid)
        || isAdmin();
    }

    match /config/points {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'dailyCheckin', 'dailyActive', 'activeMinutes', 'streakDays', 'streakBonus',
          'referralQualified', 'referralWelcome', 'qualifyDays', 'qualifyWithinDays',
          'codeEntryDays', 'maxQualifiedPerDay', 'feedbackPoints', 'feedbackAfterDays',
          'reviewAfterDays', 'reviewMinActiveDays', 'reviewEveryDays', 'levels'
        ]);
    }

    // Written only by the `submitFeedback` function.
    match /feedback/{feedbackId} {
      allow read: if isStaff();
    }

    // "What's new" notes for each app version, written in the admin side.
    match /releaseNotes/{version} {
      allow read: if (signedIn() && resource.data.published == true) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['version', 'code', 'published', 'notes', 'updatedAt'])
        && request.resource.data.version == version
        && request.resource.data.code is int
        && version.matches('^[0-9]{1,3}([.][0-9]{1,3}){1,2}$')
        && request.resource.data.published is bool
        && request.resource.data.notes is map;
      allow delete: if isAdmin();
    }

    // Petitions picked by the team. Users only see published ones, so their
    // queries must filter on `review`.
    match /petitions/{petitionId} {
      allow read: if (signedIn() && resource.data.review == 'published') || isAdmin();
      allow create: if isAdmin()
        && validPetition(request.resource.data, petitionId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && validPetition(request.resource.data, petitionId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /config/emergency {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'ringsKm', 'minRecipients', 'maxRecipients', 'autoCloseHours', 'defaultAreaKm',
          'maxSuggested', 'weightRecommended', 'weightVerified', 'weight24h', 'weightPerKm',
          'emailEnabled'
        ]);
    }

    // Written only by Cloud Functions. Owners see the checks of their own photos.
    match /photoChecks/{checkId} {
      allow read: if isStaff() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /config/moderation {
      allow read: if isStaff();
    }

    match /config/support {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['chatReplyMinutes', 'ticketReplyHours', 'autoCloseDays'])
        && request.resource.data.get('chatReplyMinutes', 1) is int
        && request.resource.data.get('ticketReplyHours', 1) is int
        && request.resource.data.get('autoCloseDays', 1) is int;
    }
  }
}
