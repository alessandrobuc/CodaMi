rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{uid}/{allPaths=**} {
      allow read: if request.auth != null && folder in ['pets', 'reports', 'emergencies'];
      allow create, update: if request.auth != null
        && folder in ['pets', 'reports', 'emergencies']
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && ((folder in ['pets', 'reports', 'emergencies'] && request.auth.uid == uid)
          || (folder == 'reports'
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'));
    }

    // Photos held by moderation. Only Cloud Functions move files in and out.
    match /quarantine/{allPaths=**} {
      allow read: if isStaff();
    }

    match /videos/{videoId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && ((fileName.matches('video\\..*')
            && request.resource.size < 200 * 1024 * 1024
            && request.resource.contentType.matches('video/.*'))
          || (fileName.matches('thumbnail(_[0-9]+)?\\..*')
            && request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
      allow delete: if isAdmin();
    }

    match /petitions/{petitionId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && fileName.matches('image_[0-9]+[.](jpg|jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /shop/{kind}/{docId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && ((kind == 'products' && fileName.matches('image_[0-9]+[.](jpg|jpeg|png|webp)'))
          || (kind == 'brands' && fileName.matches('logo_[0-9]+[.](jpg|jpeg|png|webp)')))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }

  function isStaff() {
    return request.auth != null
      && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['support', 'admin'];
  }

  function isAdmin() {
    return request.auth != null
      && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
  }
}
